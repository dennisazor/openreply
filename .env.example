# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Files page uploads (optional). Uploading commits the file to public/ in your
# GitHub repo and Vercel redeploys. Leave these unset to turn uploads off.
# Token: a fine-grained personal access token limited to this one repository,
# with Contents set to "Read and write".
GITHUB_UPLOAD_TOKEN=
# Comma-separated login emails that may upload. Nobody can upload if this is empty.
UPLOAD_ALLOWED_EMAILS=
# Detected automatically on Vercel. Set them when running anywhere else.
# GITHUB_UPLOAD_REPO=your-github-user/openreply
# GITHUB_UPLOAD_BRANCH=main
